{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFAC Agent M6A LLM Plan Proposal",
  "type": "object",
  "required": [
    "proposal_version",
    "proposal_id",
    "task",
    "status",
    "primary_problem",
    "problem_interpretation",
    "proposed_action",
    "proposed_tool",
    "proposed_tool_version",
    "evidence_refs",
    "feedback_refs",
    "required_inputs",
    "missing_inputs",
    "expected_information_gain",
    "expected_model_gain_status",
    "risk_level",
    "uncertainties",
    "assumptions",
    "stop_conditions",
    "success_conditions",
    "failure_conditions",
    "reason_codes",
    "human_readable_rationale",
    "requires_human_approval",
    "auto_execution_allowed",
    "research_needed",
    "research_query"
  ],
  "properties": {
    "proposal_version": {"type": "string"},
    "proposal_id": {"type": "string"},
    "task": {"enum": ["A1", "A2"]},
    "status": {
      "enum": ["completed", "invalid_output", "provider_unavailable", "timeout", "failed", "blocked"]
    },
    "primary_problem": {"type": "string"},
    "problem_interpretation": {"type": "string"},
    "proposed_action": {"type": "string"},
    "proposed_tool": {"type": ["string", "null"]},
    "proposed_tool_version": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "feedback_refs": {"type": "array", "items": {"type": "object"}},
    "required_inputs": {"type": "array", "items": {"type": "string"}},
    "missing_inputs": {"type": "array", "items": {"type": "string"}},
    "expected_information_gain": {"type": "string"},
    "expected_model_gain_status": {"type": "string"},
    "risk_level": {"type": "string"},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "success_conditions": {"type": "array", "items": {"type": "string"}},
    "failure_conditions": {"type": "array", "items": {"type": "string"}},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "human_readable_rationale": {"type": "string"},
    "requires_human_approval": {"type": "boolean"},
    "auto_execution_allowed": {"const": false},
    "research_needed": {"type": "boolean"},
    "research_query": {"type": "string"}
  }
}
