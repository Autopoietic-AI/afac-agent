{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFAC Evaluation Anchor Bootstrap Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "manifest_version",
    "run_id",
    "status",
    "read_only_inputs",
    "trains_model",
    "generates_prediction",
    "creates_submission",
    "counts_as_experiment_round",
    "online_deployment_anchor",
    "evaluation_anchor_identity",
    "historical_v53q1_oof_status",
    "fold_status",
    "evaluation_anchor_status",
    "artifacts"
  ],
  "properties": {
    "status": {
      "enum": [
        "materialized_from_verified_components",
        "rebuild_required",
        "waiting_for_input"
      ]
    },
    "read_only_inputs": {"const": true},
    "trains_model": {"const": false},
    "generates_prediction": {"const": false},
    "creates_submission": {"const": false},
    "counts_as_experiment_round": {"const": false},
    "historical_v53q1_oof_status": {"const": "not_materialized"}
  }
}
