{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFAC Agent M5A Planner Policy",
  "type": "object",
  "required": [
    "policy_version",
    "evidence_rank",
    "action_priority",
    "risk_policy",
    "budget_policy",
    "duplicate_policy",
    "missing_input_policy",
    "human_approval_policy",
    "branch_reopen_policy",
    "promotion_policy_refs"
  ],
  "properties": {
    "policy_version": {"type": "string"},
    "evidence_rank": {"type": "array", "items": {"type": "string"}},
    "action_priority": {"type": "array", "items": {"type": "string"}},
    "risk_policy": {"type": "object"},
    "budget_policy": {"type": "object"},
    "duplicate_policy": {"type": "object"},
    "missing_input_policy": {"type": "object"},
    "human_approval_policy": {"type": "object"},
    "branch_reopen_policy": {"type": "object"},
    "promotion_policy_refs": {"type": "array", "items": {"type": "string"}}
  }
}
