{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFAC Agent M5A PlanDecision",
  "type": "object",
  "required": [
    "planner_version",
    "plan_id",
    "task",
    "status",
    "current_stage",
    "primary_problem",
    "problem_evidence",
    "selected_action",
    "selected_tool",
    "selected_tool_version",
    "ranked_actions",
    "blocked_actions",
    "deferred_actions",
    "evidence_refs",
    "feedback_refs",
    "required_inputs",
    "missing_inputs",
    "expected_information_gain",
    "expected_model_gain_status",
    "risk_level",
    "budget_cost",
    "stop_conditions",
    "success_conditions",
    "failure_conditions",
    "reason_codes",
    "human_readable_rationale",
    "requires_human_approval",
    "auto_execution_allowed",
    "input_hashes",
    "policy_hash"
  ],
  "properties": {
    "planner_version": {"type": "string"},
    "plan_id": {"type": "string", "minLength": 1},
    "task": {"enum": ["A1", "A2"]},
    "status": {
      "enum": [
        "ready",
        "waiting_for_input",
        "no_safe_action",
        "budget_exhausted",
        "human_approval_required",
        "blocked"
      ]
    },
    "current_stage": {"type": "string"},
    "primary_problem": {"type": "string"},
    "problem_evidence": {"type": "object"},
    "selected_action": {"type": "string"},
    "selected_tool": {"type": ["string", "null"]},
    "selected_tool_version": {"type": ["string", "null"]},
    "ranked_actions": {"type": "array", "items": {"type": "object"}},
    "blocked_actions": {"type": "array", "items": {"type": "object"}},
    "deferred_actions": {"type": "array", "items": {"type": "object"}},
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "feedback_refs": {"type": "array", "items": {"type": "object"}},
    "required_inputs": {"type": "array", "items": {"type": "string"}},
    "missing_inputs": {"type": "array", "items": {"type": "string"}},
    "expected_information_gain": {"type": "string"},
    "expected_model_gain_status": {"type": "string"},
    "risk_level": {"type": "string"},
    "budget_cost": {"type": "object"},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "success_conditions": {"type": "array", "items": {"type": "string"}},
    "failure_conditions": {"type": "array", "items": {"type": "string"}},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "human_readable_rationale": {"type": "string"},
    "requires_human_approval": {"type": "boolean"},
    "auto_execution_allowed": {"type": "boolean"},
    "input_hashes": {"type": "object"},
    "policy_hash": {"type": "string"}
  }
}
