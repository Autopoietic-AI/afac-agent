{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFAC Agent Tool Registry",
  "type": "object",
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "task",
          "layer",
          "description",
          "action_type",
          "expected_runtime_seconds",
          "prediction_changing",
          "submission_creating",
          "read_only",
          "counts_as_experiment_round",
          "mutates_predictions",
          "mutates_project_state",
          "requires_gpu",
          "required_state",
          "required_inputs",
          "forbidden_closed_branches",
          "command_template"
        ],
        "properties": {
          "task": {"enum": ["A1", "A2"]},
          "prediction_changing": {"type": "boolean"},
          "submission_creating": {"type": "boolean"},
          "read_only": {"type": "boolean"},
          "counts_as_experiment_round": {"type": "boolean"},
          "mutates_predictions": {"type": "boolean"},
          "mutates_project_state": {"type": "boolean"},
          "requires_gpu": {"type": "boolean"}
          ,
          "adapter_id": {"type": "string"},
          "adapter_version": {"type": "string"},
          "adapter_entrypoint": {"type": "string"},
          "execution_mode": {"type": "string"},
          "result_schema": {"type": "string"},
          "output_policy": {"type": "object"},
          "identity_hash_fields": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
